DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-with-at-least-50-characters
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=scanner
DJANGO_DB_USER=scanner
DJANGO_DB_PASSWORD=change-this-db-password
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_USE_X_FORWARDED_HOST=True
DJANGO_USE_X_FORWARDED_PORT=True
DJANGO_USE_X_FORWARDED_PROTO=True
POSTGRES_DB=scanner
POSTGRES_USER=scanner
POSTGRES_PASSWORD=change-this-db-password
APP_PORT=80
