{
  "name": "scanner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "dev:server": "backend/.venv/bin/python backend/manage.py runserver",
    "build": "vite build --config frontend/vite.config.js",
    "build:prod": "npm run build && backend/.venv/bin/python backend/manage.py collectstatic --noinput",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "lint": "eslint .",
    "preview": "vite preview --config frontend/vite.config.js",
    "start": "backend/.venv/bin/python backend/manage.py runserver",
    "start:prod": "backend/.venv/bin/gunicorn config.wsgi:application --chdir backend --bind 0.0.0.0:8000"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.9"
  }
}
